# ---------------------------------------------------------------------
# Client-side (baked into the browser bundle at build time -- these two
# are safe to expose; Row Level Security is what protects the data).
# Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------
# Server-side only (Vercel serverless functions). NEVER prefix these with
# VITE_ -- that would ship the service-role key to every visitor.
# ---------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
